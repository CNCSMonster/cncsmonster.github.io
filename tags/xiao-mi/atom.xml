        <title>MiMo 模型配置避免降智：thinking 参数正确配置</title>
        <published>2026-05-28T00:00:00+08:00</published>
        <updated>2026-05-28T00:00:00+08:00</updated>
        
        <author>
          <name>
            
              Unknown
            
          </name>
